# Copy this file to .env and fill in your values.

# Optional: OpenAI API key for AI features.
# Leave blank to run in non-AI mode.
OPENAI_API_KEY=

# OpenAI model to use (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Enable or disable AI features globally (true/false)
AI_ENABLED=true

# App secret key for sessions (change this to something random)
SECRET_KEY=change-me-to-something-random-and-secret

# SQLite database path
DATABASE_URL=sqlite:///./work_mirror.db
